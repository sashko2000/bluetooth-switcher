<Project Sdk="Microsoft.NET.Sdk">

  <!-- Experiment: in which order do the low-level keyboard hook and raw input see a key, and does blocking a key
       in the hook also hide it from raw input? Decides how per-keyboard remapping can work. Not part of the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>InputProbe</RootNamespace>
  </PropertyGroup>

</Project>
